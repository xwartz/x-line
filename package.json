{
  "name": "x-line",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A clean and elegant X (Twitter) timeline aggregator",
  "scripts": {
    "dev": "node scripts/build-followers.mjs && vite",
    "build": "node scripts/build-followers.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "fetch-tweets": "node scripts/fetch-tweets.mjs",
    "validate-followers": "node scripts/validate-followers.mjs",
    "build-followers": "node scripts/build-followers.mjs",
    "manage-followers": "node scripts/manage-followers.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xwartz/x-line.git"
  },
