{
  "name": "x-line",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A clean and elegant X (Twitter) timeline aggregator",
  "scripts": {
    "dev": "node scripts/build-followers.mjs && vite",
    "build": "node scripts/build-followers.mjs && tsc -b && vite build",
    "preview": "pnpm run build && wrangler dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "fetch-tweets": "node scripts/fetch-tweets.mjs",
    "validate-followers": "node scripts/validate-followers.mjs",
    "build-followers": "node scripts/build-followers.mjs",
    "manage-followers": "node scripts/manage-followers.mjs",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.0.0",
    "lucide-react": "^1.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/vite-plugin": "^1.37.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.91.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xwartz/x-line.git"
  },
  "license": "MIT"
}
